# Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 构建产物（setuptools / PyInstaller 的 build、dist）
build/
dist/
*.egg
*.egg-info/
.eggs/
MANIFEST

# 虚拟环境与环境变量
.venv/
.env

# 测试与代码检查缓存
.pytest_cache/
.ruff_cache/

# 编辑器与 AI 工具
.idea/
*.iml
.vscode/
.cursor/
!.cursor/worktrees.json
.claude/
.mimocode/
.reasonix/
.zcode/            # ZCode IDE 本地会话计划产物
MagicMock/         # MagicMock 测试残留

# 操作系统
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.directory

# 临时文件与日志
*~
*.swp
*.tmp
*.temp
*.log
*.log.*

# 科学计算数据与图文件
*.csv
*.dat
*.h5
*.hdf5
*.mat
*.npy
*.npz
*.pkl
*.pickle

*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.pdf
*.eps
*.svg
# 文档静态资源（logo 等）除外
!docs/source/_static/*.png

# SPICE 内核：全部入库（含星历 .bsp，Git LFS，与 e2m2e 仓库一致）；
# 随 tauri.release.conf.json 的 "../kernels": "kernels" 映射进安装包，
# 免下载引导，应用启动即用（lib.rs 自动设 SPICE_KERNEL_DIR）

# 项目数据与输出
# 大型数据默认不入库；CR3BP 种子数据是显式例外
/data/**
!/data/cr3bp_data/
!/data/cr3bp_data/**
/output/
# 轨道库（e2m2e catalog，issue #375）：本地数据不入库
/catalog/
/scripts/output/
/results/
/out

# 基线数据集 zip（release 构建期下载，随包分发，见 release.yml）
/packaging/baseline/

# GUI 与本地配置
gui_defaults.json   # 用户自定义默认值（可能含本地路径）
e2m2e               # 符号链接（指向 ~/codes/e2m2e/e2m2e，由 setup_symlink.sh 管理）
config.ini          # 含敏感信息
secrets.json
*.key
*.pem

# 备份与压缩包
*.bak
*.backup
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# 文档构建产物
docs/_build/
docs/source/locale/**/*.mo

# 测试输出
test_output/
test_results/

# Git worktrees
.worktrees/

# pi harness 项目级 agent
.pi/
node_modules/
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/catalog/
# Tauri 打包暂存的 sidecar 二进制（CI/本地构建时复制进此目录）
src-tauri/binaries/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# Tauri 应用图标：构建 NSIS/deb 资源必需，豁免上方 *.png 全局忽略
!src-tauri/icons/*.png
!src-tauri/icons/*.ico
!src-tauri/icons/*.icns
