{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CODE",
  "version": "5.0.0",
  "identifier": "com.cislunarspace.code",
  "mainBinaryName": "cislunar-code",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CODE",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/assistant/*": "resources/assistant/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RDE4QzJCQUQxOTVGNDEKUldSQlh4bXRLNHpSbFkrNFNJL0JXR0FmWkwrOEQ5SkRhcUc2c1oyY0piNldNMjdLeU1ZZisyVDAK",
      "endpoints": [
        "https://github.com/cislunarspace/CODE/releases/latest/download/latest-code.json"
      ]
    }
  }
}
